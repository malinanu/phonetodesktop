<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shares the lock-screen login details with the app (Shared/LanyardShared.swift). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)app.phoneremote.shared</string>
	</array>
</dict>
</plist>
