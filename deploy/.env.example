# Copy to .env next to docker-compose.yml.
# DNS: an A/AAAA record for this name must point at THIS server (coturn runs here too).
FILES_DOMAIN=files.example.com
# Image tag from a release (v1.2.3 -> 1.2.3); "latest" follows the newest release.
FILES_TAG=latest

# ---- optional account service: docker compose --profile accounts up -d (see docs/ACCOUNTS.md) ----
# ACCOUNT_DB_PASSWORD=<long random>
# ACCOUNT_JWT_SECRET=<48+ random characters>
# ACCOUNT_SIGNING_KEYS=k1:<base64url 32-byte seed>   (the first key signs; add ",k0:..." to keep older certificates valid)
# SMTP_HOST=smtp.example.net  SMTP_USER=...  SMTP_PASSWORD=...  SMTP_FROM="Phone Remote <no-reply@your-domain>"
# GOOGLE_CLIENT_IDS=...  APPLE_CLIENT_IDS=app.phoneremote
